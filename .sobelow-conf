# WHISPR-979 — configuration Sobelow. Exécuter `mix sobelow` pour scanner,
# `mix sobelow.gen.config` pour régénérer ce fichier depuis les defaults.

[
  verbose: false,
  private: false,
  skip: true,
  router: "lib/whispr_messaging_web/router.ex",
  exit: "High",
  format: "txt",
  # Sobelow 0.14.1 crashe sur le pattern `socket "...", MySocket, @ws_opts`
  # (module attribute dans options de socket — cf. endpoint.ex). La check
  # Config.CSWH lit les options en s'attendant à une liste keyword inline,
  # pas à un `{:@, ...}`. À réactiver dès qu'un fix upstream sort.
  #
  # Config.HTTPS: HTTPS termination is handled at the nginx-ingress layer
  # (cf. infrastructure/k8s/whispr/preprod/messaging-service/), the Phoenix
  # Endpoint runs behind the proxy and does not need `force_ssl` set. Using
  # a fingerprint-based skip in `.sobelow-skips` was brittle because each
  # `config/prod.exs` edit shifted the hash; the ignore here is stable.
  ignore: ["Config.CSWH", "Config.HTTPS"],
  ignore_files: []
]
